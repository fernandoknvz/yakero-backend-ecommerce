# Yakero Ecommerce API - example only. Do not commit real secrets.

# App
APP_NAME="Yakero Ecommerce API"
ENVIRONMENT=production
DEBUG=false
TESTING=false
API_V1_PREFIX=/api/v1
API_BASE_URL=https://yakero-backend-ecommerce-dev.onrender.com
BACKEND_PUBLIC_URL=https://yakero-backend-ecommerce-dev.onrender.com
APP_BASE_URL=https://ecommerce.fernandoolgueadev.cl
FRONTEND_PUBLIC_URL=https://ecommerce.fernandoolgueadev.cl
INTERNAL_BOOTSTRAP_TOKEN=

# Database
# Standalone docker-compose.prod.yml overrides DATABASE_URL to use service name "db".
DATABASE_URL=mysql+aiomysql://yakero_user:change_me@db:3306/yakero_ecommerce
# Aiven/Render example:
# DATABASE_URL=mysql+aiomysql://avnadmin:change_me@mysql-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED
MYSQL_DATABASE=yakero_ecommerce
MYSQL_USER=yakero_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_root

# JWT
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRE_MINUTES=1440

# Mercado Pago
MP_ENV=production
MP_ACCESS_TOKEN=APP_USR-change_me
MP_PUBLIC_KEY=
MP_WEBHOOK_SECRET=change_me_webhook_secret
MP_BACK_URL_SUCCESS=https://yakero.cl/checkout/success
MP_BACK_URL_FAILURE=https://yakero.cl/checkout/failure
MP_BACK_URL_PENDING=https://yakero.cl/checkout/pending

# POS integration
POS_API_BASE_URL=https://posdev.tehagolaweb.cl
POS_INTERNAL_TOKEN=change_me_pos_internal_token
POS_CATALOG_TIMEOUT_SECONDS=10

# Store location for delivery fee calculation
STORE_LAT=-33.4094
STORE_LON=-70.5799

# CORS
# Comma-separated list or JSON array syntax.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://ecommerce.fernandoolgueadev.cl

# Runtime
API_PORT=8000
WEB_CONCURRENCY=2

# Naming notes for operators:
# - This app reads JWT_SECRET, not JWT_SECRET_KEY.
# - This app reads ALLOWED_ORIGINS, not CORS_ORIGINS.
# - This app reads MP_ACCESS_TOKEN, not MERCADOPAGO_ACCESS_TOKEN.
# - This app reads FRONTEND_PUBLIC_URL or APP_BASE_URL, not FRONTEND_BASE_URL.
